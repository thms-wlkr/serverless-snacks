[MASTER]
# Ignore CDK generated files
ignore=cdk.out,.venv

[MESSAGES CONTROL]
# Disabled warnings:
# - R0913/R0917: CDK constructs have many optional parameters
# - W0718: Lambda handlers catch Exception for error handling
# - W0613: Lambda requires 'context' parameter even if unused
# - E1101: False positive on CDK bundling_image
# - W0621: Pytest fixtures redefine names (how pytest works)
# - C0415: Tests use imports inside functions for relative imports
# - R0801: Some duplicate code in test
disable=R0913,R0917,W0718,W0613,E1101,W0621,C0415,R0801

[FORMAT]
# Match Black formatting
max-line-length=100
